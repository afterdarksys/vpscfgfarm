#!/Applications/Xcode.app/Contents/Developer/Library/Frameworks/Python3.framework/Versions/3.9/bin/python3.9 -I
"""vpsexec — the ONLY sanctioned entry point for ad-hoc command execution.

The outer of vpsexec's two doors, and the third door in this repo overall.
It carries its own compiled-in copy of the deny-always floor, exactly as
vpscfg-control.py does, for the same reason: a compromise of vpscfg/gates.py
must not be sufficient to open a door. tests/test_vpsexec.py asserts all three
copies are byte-identical, so drift is a failing build, not a silent hole.

Threats:
  - Protects against: the exec verb running at all before the governor releases
    it; a deny-always pattern reaching the inner door (swept over the entire
    argv, case-insensitive substring, so a payload hidden inside the quoted
    command is still caught out here); mutating exec on ANY host in a fleet
    target whose posture is frozen or lockdown, unless --break-glass is present
    (and even then the inner door demands a committed runbook); an ambiguous or
    unreadable host group; a tampered or hand-mangled policy (validated as a
    superset of the floor — a policy that drops entries refuses everything);
    bypass by calling the package directly (without the policy-hash token the
    package hard-locks to read-only).
  - Does NOT protect against: an operator who already has SSH to the host (this
    governs this door, and this door only); root editing this file AND the
    policy together, which is a git-visible act, which is the point.

Fail-closed rule: any error in loading, validating, or judging => refuse.
"""

import os
import sys

# Run isolated (-I): ignore every PYTHON* variable (PYTHONPATH, PYTHONHOME,
# PYTHONUSERBASE, PYTHONSTARTUP...), the user site-packages and the script's
# directory. Without it a sitecustomize.py on PYTHONPATH can patch
# Path.read_bytes in BOTH doors, so both obey a forged governor and the token
# still verifies (W4 review H1). The shebang names an ABSOLUTE interpreter with
# -I (`env python3` would let PATH pick a fake python3 that drops -I; W4 R1),
# so a door started by path is isolated from its first instruction. Public
# installs set the shebang to their own interpreter's absolute path. This
# re-exec only catches `python3 vpsexec`, which cannot be fully protected: a
# hostile startup hook in THAT first interpreter has run before this line.
# Callers must start the doors by path and deny the `python3 door` form.
# The shebang names the REAL interpreter binary (tools/pin-interpreter.sh):
# on macOS /usr/bin/python3 is an xcrun shim that honours DEVELOPER_DIR,
# TOOLCHAINS and SDKROOT, so it lets the environment pick the interpreter too.
# Every re-exec and child below uses _PYTHON, sys.executable resolved to its
# real file, and refuses a shim rather than run through one.


def _interpreter():
    exe = os.path.realpath(sys.executable or "")
    if not os.path.isabs(exe) or not os.path.isfile(exe) or (
            sys.platform == "darwin" and os.path.dirname(exe) == "/usr/bin"):
        sys.stderr.write("REFUSED: interpreter %r is not a real interpreter binary "
                         "(macOS /usr/bin entries are xcrun shims that honour "
                         "DEVELOPER_DIR); pin one with tools/pin-interpreter.sh\n"
                         % (sys.executable,))
        sys.exit(2)
    return exe


_PYTHON = _interpreter()

if __name__ == "__main__" and not sys.flags.isolated:
    os.execv(_PYTHON, [_PYTHON, "-I", os.path.realpath(__file__)] + sys.argv[1:])

import hashlib
import json
import shlex
from pathlib import Path

ROOT = Path(__file__).resolve().parent

# Start the inner door by path, never by the current directory. `python -m`
# puts the working directory first on sys.path, so from any other directory
# the package was not found, and a directory holding its own `vpscfg/` would
# have run that instead of this repo's door. (-P needs Python 3.11.)
_LAUNCH = ("import runpy, sys; root = sys.argv.pop(1); "
           "sys.path[:] = [root] + [p for p in sys.path if p not in ('', '.')]; "
           "runpy.run_module(%r, run_name='__main__', alter_sys=True)")
# The governor and policies/ under the estate root, set by main() from
# resolve_estate(). Default estate root = ROOT, i.e. exactly the old paths.
CONTROL_PATH = ROOT / "vpscfg-control.json"
POLICY_DIR = ROOT / "policies"
JOURNAL_DIR = ROOT / "journal"

# Third copy of the floor, by design. Releasing controls NEVER means editing
# this list down — it is compiled into the door itself.
DENY_ALWAYS_FLOOR = [
    "volume prune", "system prune", "image prune", "network prune",
    "volume rm",
    "compose down -v", "compose down --volumes",
    "DROP TABLE", "DROP DATABASE", "DROP SCHEMA",
    "TRUNCATE",
    "rm -rf /",
    "kubectl delete ns", "kubectl delete namespace",
    "mkfs", "dd if=",
    "terraform destroy",
]

VALID_MODES = ("lockdown", "test", "supervised", "released")


def floor_spellings(argv):
    """Independent outer-door quote/escape and flag-order normalization."""
    forms = [' '.join(' '.join(argv).split()).lower()]
    for value in argv:
        try:
            lexer = shlex.shlex(value.replace('\\\n', ''), posix=True, punctuation_chars=';&|<>')
            lexer.whitespace_split = True
            lexer.commenters = ''
            words = list(lexer)
        except ValueError:
            continue  # reasons/paths are argv data; the inner command parser validates syntax
        forms.append(' '.join(words).lower())
        if 'prune' in [w.lower() for w in words]:
            forms.append('volume prune')
        forms.append(' '.join(w for w in words if not w.startswith('-')).lower())
        if any(os.path.basename(w) == 'rm' for w in words):
            recursive = any(w == '--recursive' or (w.startswith('-') and not w.startswith('--') and 'r' in w.lower()) for w in words)
            force = any(w == '--force' or (w.startswith('-') and not w.startswith('--') and 'f' in w.lower()) for w in words)
            if recursive and force and any(w.startswith('/') for w in words):
                forms.append('rm -rf /')
        if any(w in ('compose', 'docker-compose') for w in words) and 'down' in words:
            if any(w == '--volumes' or (w.startswith('-') and not w.startswith('--') and 'v' in w) for w in words):
                forms.append('compose down --volumes')
    return forms
VALID_POSTURES = ("frozen", "lockdown", "test", "released")

# Postures under which vpsexec may mutate. Note this is STRICTER than deploy's
# rule (which refuses frozen/lockdown): here an unknown or misspelled posture
# refuses too, because there is no contract to fall back on.
MUTABLE_POSTURES = ("test", "released")

# Read-only introspection verbs. They name no host and change nothing, so the
# outer door lets them through as reads; the package renders them.
RESERVED_VERBS = ("hosts", "groups", "runbooks", "checks", "locks", "log", "last")


def journal(entry):
    """Journal through the package's hash-chained writer, into the same
    `vpsexec.jsonl` stream the inner door uses.

    This door used to append its own unchained lines here. The inner door's
    records are chained, so every wrapper line that landed after one of them
    read as "spliced in after the fact" to `vpscfg journal verify`, and fleet
    watch reported a failure on every sweep. Both
    doors now write one chain. The judgment above is already made by the time
    this runs, so importing the package here cannot open the door: a broken or
    hostile journal module can only make a mutation refuse (fail-closed).
    """
    entry = {"door": "vpsexec-wrapper", "argv": sys.argv[1:],
             "interpreter": sys.executable, "isolated": bool(sys.flags.isolated),
             **entry}
    try:
        if str(ROOT) not in sys.path:
            sys.path.insert(0, str(ROOT))
        from vpscfg import journal as _journal
        _journal.append("vpsexec", entry)
    except Exception as exc:  # noqa: BLE001 — any journaling failure is the same failure
        if entry.get("event") == "allowed_mutation":
            print("REFUSED: cannot journal, so cannot mutate", file=sys.stderr)
            sys.exit(3)
        print(f"(warning: vpsexec could not journal this read: {exc})",
              file=sys.stderr)


def refuse(reason, code=2):
    journal({"event": "refused", "reason": reason})
    print(f"REFUSED: {reason}", file=sys.stderr)
    print("(every vpsexec invocation is journaled; see journal/vpsexec.jsonl)",
          file=sys.stderr)
    sys.exit(code)


def resolve_estate():
    """Where the governor lives: the tool checkout, or the one directory named
    by its pinned `estate.path` file. Resolved by vpscfg/estate.py loaded BY
    FILE PATH from this checkout (not via sys.path or the working directory),
    so this door and the inner one apply one rule and reach one root; the inner
    door still refuses a VPSCFG_CONTROL_PATH that is not the root it resolves
    itself. No environment variable is consulted. Any doubt refuses."""
    try:
        import importlib.util
        spec = importlib.util.spec_from_file_location(
            "_vpscfg_estate_outer", str(ROOT / "vpscfg" / "estate.py"))
        module = importlib.util.module_from_spec(spec)
        spec.loader.exec_module(module)
        return module.resolve(str(ROOT))
    except Exception as e:  # noqa: BLE001 — any doubt about the estate is the same doubt
        refuse(f"estate root: {e}")


def load_policy():
    try:
        raw = CONTROL_PATH.read_bytes()
        policy = json.loads(raw)
    except FileNotFoundError:
        refuse(f"control file missing: {CONTROL_PATH} — nothing runs without the governor")
    except (json.JSONDecodeError, OSError) as e:
        refuse(f"control file unreadable/invalid JSON ({e}) — failing closed")

    problems = []
    if policy.get("version") != 1:
        problems.append("version must be 1")
    if policy.get("mode") not in VALID_MODES:
        problems.append(f"mode must be one of {VALID_MODES}")
    if not isinstance(policy.get("mutation_enabled"), bool):
        problems.append("mutation_enabled must be a boolean")
    verbs = policy.get("allowed_verbs")
    if not isinstance(verbs, list) or not all(isinstance(v, str) for v in verbs):
        problems.append("allowed_verbs must be a list of strings")
    deny = policy.get("deny_always")
    if not isinstance(deny, list) or not deny:
        problems.append("deny_always missing or empty")
    else:
        missing = [d for d in DENY_ALWAYS_FLOOR if d not in deny]
        if missing:
            problems.append(f"deny_always is missing floor entries (tampering?): {missing}")
    hosts = policy.get("hosts", {})
    for h, cfg in hosts.items():
        if cfg.get("posture") not in VALID_POSTURES:
            problems.append(f"host {h}: invalid posture {cfg.get('posture')!r}")
        target = cfg.get("alias_of")
        if not target:
            continue
        # An alias whose posture disagrees with its target would be posture
        # laundering: name the frozen box its other way, get a different answer.
        tcfg = hosts.get(target)
        if target == h:
            problems.append(f"host {h}: alias_of itself")
        elif not isinstance(tcfg, dict):
            problems.append(f"host {h}: alias_of {target!r}, which is not governed")
        else:
            if tcfg.get("alias_of"):
                problems.append(f"host {h}: alias_of {target!r}, which is itself "
                                "an alias — chains are refused")
            if cfg.get("posture") != tcfg.get("posture"):
                problems.append(
                    f"host {h} (posture {cfg.get('posture')!r}) is alias_of "
                    f"{target!r} (posture {tcfg.get('posture')!r}) — one machine, "
                    "two postures")
    if problems:
        refuse("control file failed validation: " + "; ".join(problems))

    policy["_hash"] = hashlib.sha256(raw).hexdigest()
    return policy


def load_groups():
    """Independent minimal read of policies/*.yaml, for group names only.

    Deliberately NOT vpscfg.vpsexecpolicy: this is the outer door, and it
    resolves the host set with its own code so that a bug in the inner door's
    parser cannot make this door judge the wrong machines. Non-recursive, so
    policies/examples/ is inert here too.
    """
    groups = {}
    if not POLICY_DIR.is_dir():
        return groups
    paths = sorted(POLICY_DIR.glob("*.yaml")) + sorted(POLICY_DIR.glob("*.yml"))
    if not paths:
        return groups
    try:
        if str(ROOT) not in sys.path:
            sys.path.insert(0, str(ROOT))
        import vpscfg  # noqa: F401 — under -I this re-adds the operator's own site-packages
        import yaml
    except ImportError:
        refuse("policies/ has files but PyYAML is unavailable — a policy that "
               "cannot be read is a policy that cannot be enforced")
    for path in paths:
        try:
            doc = yaml.safe_load(path.read_bytes())
        except (OSError, yaml.YAMLError) as e:
            refuse(f"policy {path.name} unreadable/invalid ({e}) — failing closed")
        if not isinstance(doc, dict):
            refuse(f"policy {path.name} is not a mapping — failing closed")
        for name, hosts in (doc.get("groups") or {}).items():
            if not isinstance(hosts, list) or not all(isinstance(h, str) for h in hosts):
                refuse(f"policy {path.name}: group {name!r} is not a list of hosts")
            if name in groups and groups[name] != hosts:
                refuse(f"host group {name!r} is defined twice with different "
                       "members — an ambiguous group is a fleet-sized typo")
            groups[name] = list(hosts)
    return groups


def resolve_hosts(spec, policy, groups):
    """'web1,web2' | '@dns' | '@all' | '@dns,web1' -> ordered canonical hosts.

    alias_of is applied here too, independently of the package, so this door
    judges the posture of the same machine the inner door will actually reach.
    """
    aliases = {h: cfg["alias_of"] for h, cfg in policy["hosts"].items()
               if cfg.get("alias_of")}
    hosts = []
    for token in (t.strip() for t in (spec or "").split(",")):
        if not token:
            continue
        if not token.startswith("@"):
            hosts.append(token)
        elif token[1:] == "all":
            hosts.extend(h for h in sorted(policy["hosts"]) if h not in aliases)
        elif token[1:] in groups:
            hosts.extend(groups[token[1:]])
        else:
            refuse(f"no host group {token[1:]!r} — defined groups: "
                   f"{', '.join(sorted(groups)) or 'none'} (plus @all)")
    seen, ordered = set(), []
    for h in hosts:
        canonical = aliases.get(h, h)
        if canonical not in seen:
            seen.add(canonical)
            ordered.append(canonical)
    return ordered


def judge(policy, argv):
    """Coarse outer judgment. The inner door re-derives all of this with the
    command actually classified and the runbooks actually validated — two
    doors, same rules, independent code."""
    if not argv or argv[0] in ("-h", "--help", "help"):
        return {"verb": "exec", "hosts": [], "read_only": True, "break_glass": False}

    if "exec" not in policy["allowed_verbs"]:
        refuse("verb 'exec' is not in allowed_verbs — the governor has not "
               "released vpsexec")

    # deny_always sweep over the ENTIRE argv, including the quoted command.
    spellings = floor_spellings(argv)
    for pattern in policy["deny_always"]:
        if any(pattern.lower() in text for text in spellings):
            refuse(f"argument matches deny_always pattern {pattern!r} — never "
                   "allowed through this door, and no policy file can lift it")

    if argv[0] in RESERVED_VERBS:
        return {"verb": "exec", "hosts": [], "read_only": True,
                "break_glass": False, "introspect": argv[0]}

    # `reconcile <host>` releases a retained per-host lock: the door's own
    # bookkeeping, not a change to a service, so posture does not gate it (a
    # break-glass step is what took the lock). It is still judged as a
    # mutation here (master switch, mode, journal-or-refuse); the package
    # demands a real TTY, shows the evidence and asks for a typed phrase.
    # `reconcile <host> --stop` signals the op's step(s) (STOP:<host>:<op8>),
    # judged the same way; it is the only flag.
    if argv[0] == "reconcile":
        if not policy["mutation_enabled"]:
            refuse("mutation_enabled is false — the master switch is off")
        if policy["mode"] == "lockdown":
            refuse("mode is 'lockdown' — no mutations in lockdown")
        if (len(argv) not in (2, 3) or argv[1].startswith("-") or argv[1].startswith("@")
                or (len(argv) == 3 and argv[2] != "--stop")):
            refuse("usage: vpsexec reconcile <host> [--stop]   (one host)")
        return {"verb": "exec", "hosts": resolve_hosts(argv[1], policy, {}),
                "read_only": False, "break_glass": False, "introspect": "reconcile"}

    # `grant ...` mints, lists, shows or revokes an approval contract: a local
    # file under ~/.vpscfg, never a host. Using one is a normal mutation and
    # gets judged as one; minting needs a TTY and a typed phrase in the package.
    if argv[0] == "grant":
        return {"verb": "exec", "hosts": [], "read_only": True,
                "break_glass": False, "introspect": "grant"}

    # `incident open|close|status` is the same kind of local file under
    # ~/.vpscfg: TTY plus a typed phrase in the package, never a host. A
    # command run UNDER an incident is an ordinary mutation and is judged below
    # (--break-glass still needed for a frozen host at this door).
    if argv[0] == "incident":
        return {"verb": "exec", "hosts": [], "read_only": True,
                "break_glass": False, "introspect": "incident"}

    # `check <name>` runs a named READ play. The package re-enters its own
    # dispatch with the command spelled out, so every gate still applies; this
    # door only needs to know it cannot be a mutation.
    if argv[0] == "check":
        if "--run" in argv:
            refuse("`vpsexec check` runs reads only — --run is meaningless here")
        return {"verb": "exec", "hosts": [], "read_only": True,
                "break_glass": False, "introspect": "check"}

    # `runbook lint|preflight <file>` reads a local policy file and, for
    # preflight, sends fixed reads that the package classifies like any other.
    if argv[0] == "runbook":
        if "--run" in argv:
            refuse("`vpsexec runbook` only reads — --run is meaningless here")
        return {"verb": "exec", "hosts": [], "read_only": True,
                "break_glass": False, "introspect": "runbook"}

    spec = argv[0] if not argv[0].startswith("-") else None
    hosts = resolve_hosts(spec, policy, load_groups()) if spec else []
    break_glass = "--break-glass" in argv

    # Flag-sensitive, same rule as deploy/ansible: --run makes it a mutation.
    read_only = "--run" not in argv

    if not read_only:
        if not policy["mutation_enabled"]:
            refuse("mutation_enabled is false — the master switch is off")
        if policy["mode"] == "lockdown":
            refuse("mode is 'lockdown' — no mutations in lockdown")
        if not hosts:
            refuse("no host named — usage: vpsexec <hosts> '<command>' [flags]")
        blocked = [h for h in hosts
                   if policy["hosts"].get(h, {}).get("posture", "frozen")
                   not in MUTABLE_POSTURES]
        if blocked and not break_glass:
            detail = ", ".join(
                f"{h}({policy['hosts'].get(h, {}).get('posture', 'frozen')})"
                for h in blocked)
            refuse(f"{len(blocked)} of {len(hosts)} host(s) refuse mutations by "
                   f"posture: {detail}. A committed break_glass runbook plus "
                   "--break-glass reaches them during an incident.")
        # With --break-glass the inner door must still find a runbook marked
        # break_glass: true naming this exact command for each elevated host.
        # This door only confirms the master switch and mode still allow it.

    return {"verb": "exec", "hosts": hosts, "read_only": read_only,
            "break_glass": break_glass}


def main():
    global CONTROL_PATH, POLICY_DIR
    argv = sys.argv[1:]
    estate = resolve_estate()
    CONTROL_PATH, POLICY_DIR = Path(estate.governor), Path(estate.policies)
    policy = load_policy()
    judgment = judge(policy, argv)

    journal({
        "event": "allowed_read" if judgment["read_only"] else "allowed_mutation",
        "judgment": judgment,
        "break_glass_requested": judgment["break_glass"],
        "policy_hash": policy["_hash"][:12],
        "mode": policy["mode"],
        **estate.record(policy["_hash"]),
    })

    env = os.environ.copy()
    env["VPSCFG_CONTROL_TOKEN"] = policy["_hash"]
    env["VPSCFG_CONTROL_PATH"] = str(CONTROL_PATH)

    os.execve(
        _PYTHON,
        [_PYTHON, "-I", "-c", _LAUNCH % "vpscfg.vpsexec", str(ROOT), *argv],
        env,
    )
    return 0  # unreachable; execve replaces the process


if __name__ == "__main__":
    sys.exit(main())
